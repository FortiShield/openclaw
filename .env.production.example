# Production Environment Variables for CLAWDIS Dashboard
# Copy this file to .env.production and fill in the actual values
# NEVER commit actual values to git - use your hosting provider's secrets manager

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://dashboard.clawdis.dev
NEXT_PUBLIC_APP_VERSION=2.0.0

# Gateway Configuration (Required)
# Replace with your actual production gateway endpoints
NEXT_PUBLIC_GATEWAY_BASE_URL=https://gateway.clawdis.dev
NEXT_PUBLIC_GATEWAY_WS_URL=wss://gateway.clawdis.dev

# Error Tracking and Monitoring (Optional)
# Sentry configuration for error tracking and performance monitoring
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Analytics (Optional)
# Vercel Analytics ID for performance metrics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id-here

# Third-party Integrations (Optional)
# Twilio for WhatsApp integration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=+1234567890

# Telegram integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmnoPQRstuvwxyz

# Security Configuration
# Set to 'true' to enable strict content security policy
NEXT_PUBLIC_CSP_STRICT=true

# Rate Limiting
# Requests per minute for API endpoints
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Session Configuration
# Maximum age for session cookies (in seconds)
SESSION_MAX_AGE=2592000
